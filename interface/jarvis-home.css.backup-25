#jarvis-cinematic-home {
  position:fixed; inset:0; z-index:99999;
  overflow:hidden; color:#e8f8ff;
  font-family:Inter,sans-serif;
  background:
    radial-gradient(ellipse at 52% 55%,#06345b 0%,transparent 42%),
    radial-gradient(ellipse at 50% 100%,#0064a8 0%,transparent 45%),
    #02060d;
}
#jarvis-cinematic-home .reactor {
  position:absolute; left:50%; top:43%;
  width:min(38vw,430px); aspect-ratio:1;
  transform:translate(-50%,-50%);
  border:3px solid #36dfff; border-radius:50%;
  box-shadow:0 0 25px #00aaff, inset 0 0 35px #008cff;
  background:repeating-radial-gradient(circle,
    transparent 0 48px,#087db5 50px 52px,transparent 55px 70px);
}
#jarvis-cinematic-home .reactor:before {
  content:"JARVIS"; position:absolute; inset:0;
  display:grid; place-items:center;
  color:#65eaff; letter-spacing:6px;
  text-shadow:0 0 20px #00caff;
}

#jarvis-cinematic-home .layout {
  position:absolute;inset:25px;display:grid;
  grid-template-columns:185px 1fr 300px;gap:22px;
}
#jarvis-cinematic-home .glass {
  border:1px solid #167ba7;border-radius:16px;
  background:rgba(3,20,36,.78);
  box-shadow:0 0 20px #003b65;
  backdrop-filter:blur(14px);padding:18px;
}
#jarvis-cinematic-home .sidebar {display:flex;flex-direction:column;gap:13px}
#jarvis-cinematic-home .sidebar button {
  background:transparent;border:1px solid transparent;
  padding:13px;text-align:left;color:#b8d7e8;border-radius:9px;
}
#jarvis-cinematic-home .sidebar button:hover {
  border-color:#20cfff;color:#65eaff;
  background:rgba(0,150,255,.12);
}
#jarvis-cinematic-home .center {
  position:relative;display:flex;align-items:center;
  justify-content:center;min-width:0;
}
#jarvis-cinematic-home .reactor {
  width:min(35vw,430px);z-index:2;
}
#jarvis-cinematic-home .right {
  display:flex;flex-direction:column;gap:18px;
}
#jarvis-cinematic-home .right h3 {
  color:#dff7ff;font-size:16px;margin:0 0 15px;
}
#jarvis-cinematic-home .right p {
  color:#91b5ca;font-size:13px;line-height:1.7;
}
#jarvis-cinematic-home .voice {
  position:absolute;bottom:25px;left:22%;right:22%;
  height:70px;border:2px solid #27cfff;border-radius:45px;
  background:#031321;box-shadow:0 0 25px #007dbb;
  display:flex;align-items:center;padding:15px 25px;
  color:#65eaff;letter-spacing:2px;
}
@media(max-width:900px) {
  #jarvis-cinematic-home .layout {grid-template-columns:65px 1fr}
  #jarvis-cinematic-home .right {display:none}
}

#jarvis-cinematic-home .reactor {
  border:3px solid transparent;
  background:
    linear-gradient(#03101d,#03101d) padding-box,
    conic-gradient(from 0deg,#00d9ff,#07528b,#a4f5ff,#0066a8,#00d9ff) border-box;
  animation:reactorRotate 18s linear infinite;
}
#jarvis-cinematic-home .reactor:after {
  content:"";
  position:absolute;inset:12%;
  border:2px dashed rgba(70,220,255,.8);
  border-radius:50%;
  box-shadow:0 0 25px #008cff,inset 0 0 25px #007bbb;
  animation:reactorReverse 24s linear infinite;
}
#jarvis-cinematic-home .reactor:before {
  content:"JARVIS";
  position:absolute;inset:0;display:grid;place-items:center;
  color:#9af4ff;font-size:clamp(18px,2vw,30px);
  letter-spacing:9px;
  text-shadow:0 0 10px #00cfff,0 0 35px #008cff;
  animation:reactorPulse 3s ease-in-out infinite;
}
@keyframes reactorRotate {
  to {transform:translate(-50%,-50%) rotate(360deg)}
}
@keyframes reactorReverse {
  to {transform:rotate(-360deg)}
}
@keyframes reactorPulse {
  50% {text-shadow:0 0 25px #00dfff,0 0 55px #008cff}
}
#jarvis-cinematic-home .center:after {
  content:"";
  position:absolute;inset:5%;
  background:radial-gradient(ellipse,transparent 35%,rgba(0,132,255,.12));
  pointer-events:none;
}
@media(prefers-reduced-motion:reduce) {
  #jarvis-cinematic-home * {animation:none!important}
}
#jarvis-cinematic-home .jh-actions {
  position:absolute;bottom:12%;display:flex;gap:14px;
  justify-content:center;flex-wrap:wrap;width:100%;
}
#jarvis-cinematic-home .jh-actions button {
  background:rgba(2,24,42,.85);border:1px solid #168bbd;
  border-radius:12px;padding:12px 17px;color:#75eaff;
  box-shadow:0 0 13px #004b78;min-width:75px;
}
#jarvis-cinematic-home .jh-actions button b {
  display:block;font-size:22px;margin-bottom:5px;
}
#jarvis-cinematic-home .jh-actions button small {
  color:#b5d8e8;font-size:10px;
}

#jarvis-cinematic-home .center:before {
  content:"";
  position:absolute;left:-15%;right:-15%;top:43%;
  height:34%;border-radius:50% 50% 0 0;
  border-top:2px solid #25bfff;
  background:linear-gradient(180deg,
    rgba(0,120,220,.22),rgba(0,10,25,.85));
  box-shadow:0 -8px 35px #007acb;
  pointer-events:none;
}
#jarvis-cinematic-home .center {
  perspective:900px;
}
#jarvis-cinematic-home .center:after {
  content:"";
  position:absolute;left:-20%;right:-20%;bottom:-28%;
  height:45%;transform:rotateX(65deg);
  transform-origin:top;
  background:
    linear-gradient(#087db5 1px,transparent 1px),
    linear-gradient(90deg,#087db5 1px,transparent 1px);
  background-size:45px 35px;
  opacity:.24;pointer-events:none;
  mask-image:linear-gradient(#000,transparent);
}
#jarvis-cinematic-home .glass {
  border-color:rgba(62,190,255,.42);
  box-shadow:0 0 25px rgba(0,135,255,.16),
    inset 0 0 25px rgba(70,180,255,.06);
}
#jarvis-cinematic-home .sidebar h2 {
  color:#76eaff;letter-spacing:5px;
  text-shadow:0 0 15px #008cff;
}

#jarvis-cinematic-home .reactor {
  outline:1px solid rgba(120,235,255,.5);
  outline-offset:12px;
}
#jarvis-cinematic-home .reactor:after {
  inset:10%;
  border:3px dashed #48dfff;
  box-shadow:0 0 18px #00aaff,
    inset 0 0 22px #007cff;
}
#jarvis-cinematic-home .reactor {
  box-shadow:0 0 35px #008cff,
    0 0 85px rgba(0,120,255,.35),
    inset 0 0 45px #006ba8;
}
#jarvis-cinematic-home .center .reactor {
  animation:reactorFloat 6s ease-in-out infinite,
    reactorRotate 35s linear infinite;
}
@keyframes reactorFloat {
  50% {margin-top:-12px;filter:brightness(1.25)}
}
#jarvis-cinematic-home .jh-actions button {
  transition:transform .25s,box-shadow .25s;
}
#jarvis-cinematic-home .jh-actions button:hover {
  transform:translateY(-6px);
  box-shadow:0 0 25px #00aaff;
}
#jarvis-cinematic-home .voice {
  backdrop-filter:blur(18px);
}

#jarvis-cinematic-home .voice {
  position:relative;
  border:1px solid rgba(45,190,255,.55);
  border-radius:18px;
  background:rgba(2,15,32,.82);
  box-shadow:0 0 25px rgba(0,145,255,.18);
  padding:18px 24px;
}
#jarvis-cinematic-home .voice:before {
  content:"";
  position:absolute;
  top:0;left:15%;right:15%;
  height:1px;
  background:linear-gradient(90deg,
    transparent,#62eaff,transparent);
}
#jarvis-cinematic-home .voice button {
  border:1px solid rgba(70,200,255,.6);
  background:rgba(0,95,155,.2);
  color:#a8edff;
  border-radius:50%;
  transition:.25s;
}
#jarvis-cinematic-home .voice button:hover {
  background:rgba(0,145,220,.4);
  box-shadow:0 0 20px #00aaff;
}
#jarvis-cinematic-home .sidebar,
#jarvis-cinematic-home .right {
  backdrop-filter:blur(16px);
  background:rgba(3,12,27,.76);
  border-color:rgba(45,170,230,.22);
}
#jarvis-cinematic-home .glass {
  transition:border-color .3s,transform .3s;
}
#jarvis-cinematic-home .glass:hover {
  border-color:rgba(80,220,255,.8);
  transform:translateY(-3px);
}

#jarvis-cinematic-home .voice {
  position:relative;
  border:1px solid rgba(45,190,255,.55);
  border-radius:18px;
  background:rgba(2,15,32,.82);
  box-shadow:0 0 25px rgba(0,145,255,.18);
  padding:18px 24px;
}
#jarvis-cinematic-home .voice:before {
  content:"";
  position:absolute;
  top:0;left:15%;right:15%;
  height:1px;
  background:linear-gradient(90deg,
    transparent,#62eaff,transparent);
}
#jarvis-cinematic-home .voice button {
  border:1px solid rgba(70,200,255,.6);
  background:rgba(0,95,155,.2);
  color:#a8edff;
  border-radius:50%;
  transition:.25s;
}
#jarvis-cinematic-home .voice button:hover {
  background:rgba(0,145,220,.4);
  box-shadow:0 0 20px #00aaff;
}
#jarvis-cinematic-home .sidebar,
#jarvis-cinematic-home .right {
  backdrop-filter:blur(16px);
  background:rgba(3,12,27,.76);
  border-color:rgba(45,170,230,.22);
}
#jarvis-cinematic-home .glass {
  transition:border-color .3s,transform .3s;
}
#jarvis-cinematic-home .glass:hover {
  border-color:rgba(80,220,255,.8);
  transform:translateY(-3px);
}

#jarvis-cinematic-home .sidebar,
#jarvis-cinematic-home .right {
  position:relative;
}
#jarvis-cinematic-home .sidebar:after,
#jarvis-cinematic-home .right:after {
  content:"";
  position:absolute;
  top:12px;left:12px;
  width:22px;height:22px;
  border-top:1px solid #42cfff;
  border-left:1px solid #42cfff;
  pointer-events:none;
}
#jarvis-cinematic-home .glass {
  position:relative;
  overflow:hidden;
}
#jarvis-cinematic-home .glass:before {
  content:"";
  position:absolute;
  top:0;left:-100%;
  width:60%;height:1px;
  background:linear-gradient(90deg,
    transparent,#75eaff,transparent);
  animation:hudScan 7s linear infinite;
}
@keyframes hudScan {
  to {left:140%}
}
#jarvis-cinematic-home .center {
  background:radial-gradient(ellipse at 50% 48%,
    rgba(0,90,170,.13),transparent 65%);
}
#jarvis-cinematic-home .jh-actions {
  filter:drop-shadow(0 0 12px rgba(0,140,255,.12));
}

#jarvis-cinematic-home .sidebar,
#jarvis-cinematic-home .right {
  position:relative;
}
#jarvis-cinematic-home .sidebar:after,
#jarvis-cinematic-home .right:after {
  content:"";
  position:absolute;
  top:12px;left:12px;
  width:22px;height:22px;
  border-top:1px solid #42cfff;
  border-left:1px solid #42cfff;
  pointer-events:none;
}
#jarvis-cinematic-home .glass {
  position:relative;
  overflow:hidden;
}
#jarvis-cinematic-home .glass:before {
  content:"";
  position:absolute;
  top:0;left:-100%;
  width:60%;height:1px;
  background:linear-gradient(90deg,
    transparent,#75eaff,transparent);
  animation:hudScan 7s linear infinite;
}
@keyframes hudScan {
  to {left:140%}
}
#jarvis-cinematic-home .center {
  background:radial-gradient(ellipse at 50% 48%,
    rgba(0,90,170,.13),transparent 65%);
}
#jarvis-cinematic-home .jh-actions {
  filter:drop-shadow(0 0 12px rgba(0,140,255,.12));
}

#jarvis-cinematic-home .center {
  isolation:isolate;
}
#jarvis-cinematic-home .reactor {
  position:relative;
  filter:drop-shadow(0 0 18px rgba(0,170,255,.45));
}
#jarvis-cinematic-home .reactor:before {
  text-shadow:0 0 12px #00bfff,
    0 0 30px #008cff;
}
#jarvis-cinematic-home .glass {
  background:linear-gradient(145deg,
    rgba(12,35,60,.72),
    rgba(2,12,27,.82));
}
#jarvis-cinematic-home .sidebar button,
#jarvis-cinematic-home .right button {
  transition:all .2s ease;
}
#jarvis-cinematic-home .sidebar button:hover,
#jarvis-cinematic-home .right button:hover {
  color:#8eeeff;
  border-color:rgba(70,210,255,.6);
  background:rgba(0,115,180,.16);
}
@media(prefers-reduced-motion:reduce) {
  #jarvis-cinematic-home *,
  #jarvis-cinematic-home *:before,
  #jarvis-cinematic-home *:after {
    animation:none!important;
    transition:none!important;
  }
}

@media(max-width:1100px) {
  #jarvis-cinematic-home .layout {
    grid-template-columns:190px minmax(0,1fr);
  }
  #jarvis-cinematic-home .right {
    display:none;
  }
}
@media(max-width:700px) {
  #jarvis-cinematic-home .layout {
    grid-template-columns:1fr;
  }
  #jarvis-cinematic-home .sidebar {
    display:none;
  }
  #jarvis-cinematic-home .center {
    min-width:0;
    padding:12px;
  }
  #jarvis-cinematic-home .reactor {
    transform:scale(.75);
  }
  #jarvis-cinematic-home .jh-actions {
    flex-wrap:wrap;
  }
  #jarvis-cinematic-home .voice {
    padding:12px;
  }
}

/* REACTOR — layered mechanical rings */
#jarvis-cinematic-home .center .reactor {
  animation:reactorFloat 6s ease-in-out infinite;
  border:2px solid rgba(105,225,255,.8);
  box-shadow:
    0 0 18px #008cff,
    0 0 55px rgba(0,145,255,.5),
    inset 0 0 25px rgba(0,160,255,.35),
    inset 0 0 65px rgba(0,30,80,.8);
}
#jarvis-cinematic-home .reactor:after {
  border:3px dashed #48dfff;
  outline:2px solid rgba(50,170,255,.35);
  outline-offset:9px;
  animation:reactorRingSpin 24s linear infinite;
}
@keyframes reactorRingSpin {
  from {transform:rotate(0deg)}
  to {transform:rotate(360deg)}
}
#jarvis-cinematic-home .reactor:before {
  text-shadow:
    0 0 8px #00cfff,
    0 0 22px #008cff,
    0 0 45px #005bff;
}

/* REACTOR — layered mechanical rings */
#jarvis-cinematic-home .center .reactor {
  animation:reactorFloat 6s ease-in-out infinite;
  border:2px solid rgba(105,225,255,.8);
  box-shadow:
    0 0 18px #008cff,
    0 0 55px rgba(0,145,255,.5),
    inset 0 0 25px rgba(0,160,255,.35),
    inset 0 0 65px rgba(0,30,80,.8);
}
#jarvis-cinematic-home .reactor:after {
  border:3px dashed #48dfff;
  outline:2px solid rgba(50,170,255,.35);
  outline-offset:9px;
  animation:reactorRingSpin 24s linear infinite;
}
@keyframes reactorRingSpin {
  from {transform:rotate(0deg)}
  to {transform:rotate(360deg)}
}
#jarvis-cinematic-home .reactor:before {
  text-shadow:
    0 0 8px #00cfff,
    0 0 22px #008cff,
    0 0 45px #005bff;
}

/* CINEMATIC HUD PANEL DETAILS */
#jarvis-cinematic-home .glass {
  border:1px solid rgba(60,190,255,.38);
  background:
    linear-gradient(135deg,
      rgba(12,42,70,.72),
      rgba(2,10,25,.88));
  box-shadow:
    0 0 18px rgba(0,135,255,.12),
    inset 0 0 20px rgba(0,140,255,.06);
}
#jarvis-cinematic-home .glass:after {
  content:"";
  position:absolute;
  right:10px;bottom:10px;
  width:18px;height:18px;
  border-right:1px solid #43cfff;
  border-bottom:1px solid #43cfff;
  opacity:.75;
  pointer-events:none;
}
#jarvis-cinematic-home .sidebar,
#jarvis-cinematic-home .right {
  box-shadow:
    0 0 30px rgba(0,100,200,.08),
    inset 0 0 25px rgba(0,100,200,.04);
}
#jarvis-cinematic-home .sidebar button,
#jarvis-cinematic-home .right button {
  border-radius:7px;
  letter-spacing:.5px;
}

/* JARVIS — TYPOGRAPHY & VISUAL HIERARCHY */
#jarvis-cinematic-home {
  color:#d8f5ff;
  font-family:"SF Pro Display","Helvetica Neue",sans-serif;
  letter-spacing:.25px;
}
#jarvis-cinematic-home h1,
#jarvis-cinematic-home h2,
#jarvis-cinematic-home h3 {
  color:#a8eaff;
  font-weight:500;
  letter-spacing:2px;
  text-shadow:0 0 12px rgba(0,160,255,.3);
}
#jarvis-cinematic-home .sidebar button {
  font-size:12px;
  font-weight:500;
  letter-spacing:1.2px;
  text-transform:uppercase;
}
#jarvis-cinematic-home .glass {
  color:rgba(220,245,255,.9);
  font-size:13px;
}
#jarvis-cinematic-home .voice {
  letter-spacing:1px;
  color:#b8edff;
}
#jarvis-cinematic-home .jh-actions button {
  font-size:11px;
  font-weight:600;
  letter-spacing:1px;
  text-transform:uppercase;
}

/* CINEMATIC ENVIRONMENT */
#jarvis-cinematic-home .center {
  background:
    radial-gradient(ellipse at 50% 42%,
      rgba(0,115,220,.2),transparent 48%),
    radial-gradient(ellipse at 50% 100%,
      rgba(0,80,160,.2),transparent 65%),
    linear-gradient(180deg,#020916,#030b18 65%,#01050d);
}
#jarvis-cinematic-home .center:after {
  background:
    linear-gradient(rgba(35,160,255,.22) 1px,transparent 1px),
    linear-gradient(90deg,rgba(35,160,255,.22) 1px,transparent 1px);
  background-size:55px 42px;
  opacity:.2;
  mask-image:linear-gradient(to bottom,#000,transparent 85%);
}
#jarvis-cinematic-home .center:before {
  box-shadow:
    0 -8px 35px rgba(0,130,255,.5),
    0 0 90px rgba(0,100,220,.15);
}
#jarvis-cinematic-home .layout {
  background:radial-gradient(
    ellipse at center,
    transparent 45%,
    rgba(0,0,0,.38) 100%);
}

/* REACTOR — ENERGY CORE */
#jarvis-cinematic-home .reactor {
  background:
    radial-gradient(circle at 35% 30%,
      rgba(170,240,255,.95) 0%,
      rgba(0,170,255,.55) 9%,
      rgba(0,55,130,.8) 28%,
      rgba(0,10,35,.98) 65%,
      #01040c 100%);
  border:2px solid rgba(120,225,255,.85);
  box-shadow:
    0 0 15px #00bfff,
    0 0 45px rgba(0,130,255,.65),
    0 0 100px rgba(0,100,255,.28),
    inset 0 0 35px rgba(0,180,255,.55);
}
#jarvis-cinematic-home .reactor:after {
  border:3px dashed rgba(110,225,255,.95);
  box-shadow:
    0 0 15px #00aeff,
    inset 0 0 20px rgba(0,140,255,.3);
}
#jarvis-cinematic-home .reactor:before {
  color:#e1fbff;
  text-shadow:
    0 0 8px #fff,
    0 0 20px #00cfff,
    0 0 45px #007bff;
}

/* REACTOR — TECHNICAL MARKERS */
#jarvis-cinematic-home .reactor {
  outline:1px solid rgba(95,210,255,.5);
  outline-offset:18px;
}
#jarvis-cinematic-home .reactor {
  background-clip:padding-box;
}
#jarvis-cinematic-home .center {
  overflow:hidden;
}
#jarvis-cinematic-home .center .reactor {
  filter:drop-shadow(0 0 16px rgba(0,175,255,.5));
}
#jarvis-cinematic-home .glass {
  border-radius:10px;
}
#jarvis-cinematic-home .glass h3 {
  border-bottom:1px solid rgba(60,190,255,.2);
  padding-bottom:9px;
}
#jarvis-cinematic-home .sidebar button:focus-visible,
#jarvis-cinematic-home .jh-actions button:focus-visible {
  outline:2px solid #65ddff;
  outline-offset:4px;
}

/* HUD — PANEL SPACING */
#jarvis-cinematic-home .layout {
  gap:20px;
  padding:20px;
}
#jarvis-cinematic-home .sidebar,
#jarvis-cinematic-home .right {
  min-width:0;
  border-radius:14px;
  padding:18px;
}
#jarvis-cinematic-home .center {
  min-width:0;
  min-height:0;
  border-radius:14px;
}
#jarvis-cinematic-home .glass {
  padding:16px;
  margin-bottom:14px;
}
#jarvis-cinematic-home .sidebar button {
  width:100%;
  text-align:left;
  padding:11px 13px;
  margin:3px 0;
}
#jarvis-cinematic-home .jh-actions {
  justify-content:center;
  gap:12px;
}
